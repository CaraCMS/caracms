{
  "name": "caracms",
  "version": "0.21.0",
  "description": "A visual CMS for Astro sites, with content in git.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaraCMS/caracms.git",
    "directory": "packages/caracms"
  },
  "homepage": "https://github.com/CaraCMS/caracms#readme",
  "bugs": {
    "url": "https://github.com/CaraCMS/caracms/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./content": "./src/content.ts",
    "./document": "./src/document.ts",
    "./serialize": "./src/serialize.ts",
    "./measure": "./src/measure.ts",
    "./files": "./src/files.ts",
    "./virtual": {
      "types": "./src/virtual.d.ts"
    },
    "./components/*": "./src/components/*"
  },
  "bin": {
    "caracms": "bin/caracms.mjs"
  },
  "files": [
    "src",
    "bin",
    "site-skills",
    "starlight-kit",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:browser && pnpm run test:visual",
    "test:unit": "node --test --experimental-strip-types $(find test starlight-kit/test -name '*.test.ts' ! -name '*.browser.test.ts' ! -name '*.visual.test.ts' ! -name '*.release.test.ts' | sort)",
    "test:browser": "node --test --experimental-strip-types --test-concurrency=2 $(find test -name '*.browser.test.ts' | sort)",
    "test:visual": "node --test --experimental-strip-types --test-concurrency=3 $(find test -name '*.visual.test.ts' | sort)",
    "check": "tsc --noEmit -p tsconfig.json && astro check --root .",
    "test:pick": "node --experimental-strip-types test/pick.ts",
    "test:release": "node --test --experimental-strip-types $(find test -name '*.release.test.ts' | sort)"
  },
  "dependencies": {
    "@mux/mux-player": "3.13.4",
    "@mux/upchunk": "3.5.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "aws4fetch": "1.0.20",
    "github-slugger": "2.0.0",
    "harfbuzzjs": "1.6.3",
    "idiomorph": "0.8.0",
    "ioredis": "5.11.1",
    "react": "19.3.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.3.0"
  },
  "peerDependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^6.0.6",
    "@astrojs/starlight": "0.42.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "astro": "^7.3.8",
    "playwright-core": "1.63.0",
    "typescript": "^6.0.3"
  }
}
