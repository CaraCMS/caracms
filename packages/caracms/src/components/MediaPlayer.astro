---
/**
 * A clip that plays as a player (M5b Decision 4), drawn by Media.astro: its poster
 * (Mux's WebP still) and one real `<button>`, "Play video: {name}" ("Play video" with
 * no name). The first click imports `@mux/mux-player` and swaps in `<mux-player>`
 * with sound (media-player.ts). Only this component carries a script, so a page
 * without a player ships none.
 *
 * The caller's `class` and `style` go on the frame (`.cms-player`), which the block's
 * CSS sizes; the poster covers it. The button's look is the site's to restyle
 * (`.cms-player-button`); the defaults here only make it usable.
 */
import type { RenderClip } from '../media-value.ts';

interface Props {
	clip: RenderClip;
	loading: 'eager' | 'lazy';
	fetchpriority?: 'high' | 'low' | 'auto';
	class?: string;
	style?: string;
	markers?: Record<string, unknown>;
}

const { clip, loading, fetchpriority, class: className, style, markers = {} } = Astro.props;
const label = clip.name ? `Play video: ${clip.name}` : 'Play video';
const length = (() => {
	if (!clip.duration) return '';
	const total = Math.round(clip.duration);
	return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
})();
---

<div class:list={['cms-player', className]} style={style} data-caracms-player data-playback-id={clip.playbackId} data-name={clip.name} data-poster={clip.poster} {...markers}>
	<img class="cms-player-poster" src={clip.poster} alt="" width={clip.w ?? undefined} height={clip.h ?? undefined} loading={loading} fetchpriority={fetchpriority} decoding="async" />
	<button type="button" class="cms-player-button" aria-label={label} data-caracms-play>
		<span class="cms-player-icon" aria-hidden="true"></span>
		<span aria-hidden="true">Play video</span>
		{length && <small aria-hidden="true">{length}</small>}
	</button>
</div>

<script>
	import { initPlayers } from './media-player.ts';

	initPlayers();
</script>

<style is:global>
	.cms-player {
		position: relative;
		overflow: hidden;
	}

	.cms-player-poster,
	.cms-player mux-player {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cms-player-button {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		padding: 0.5rem 1.125rem 0.5rem 0.5rem;
		border: 0;
		border-radius: 999px;
		background: #fff;
		color: #111;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.cms-player-icon {
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: #111;
	}

	.cms-player-icon::after {
		content: '';
		margin-left: 3px;
		border-left: 10px solid #fff;
		border-top: 6px solid transparent;
		border-bottom: 6px solid transparent;
	}

	.cms-player.is-playing .cms-player-poster,
	.cms-player.is-playing .cms-player-button {
		display: none;
	}
</style>
