---
/**
 * The table block (table.ts): the header row, then the rows, each padded to the widest row.
 * Wrapped so it scrolls sideways when it's wider than the screen.
 */
import Block from 'caracms/components/Block.astro';
import RichText from 'caracms/components/RichText.astro';
import type { BlockProps } from 'caracms/document';
import type { TableData } from './table.ts';

type Props = BlockProps<TableData>;
const { block, cms } = Astro.props;
const header = block.header ?? [];
const rows = (block.rows ?? []).map((row) => row.cells ?? []);
const width = Math.max(0, header.length, ...rows.map((cells) => cells.length));
const pad = (n: number) => Array.from({ length: Math.max(0, width - n) });
---

<Block cms={cms} as="div" class="sl-kit-table">
	{width === 0 && cms.preview && <p class="sl-kit-empty">No rows yet: add the header and rows in the block's settings.</p>}
	{width > 0 && (
		<table>
			{header.length > 0 && (
				<thead>
					<tr>
						{header.map((cell, i) => <th><RichText cms={cms} field={`header.${i}`} value={cell} /></th>)}
						{pad(header.length).map(() => <th />)}
					</tr>
				</thead>
			)}
			<tbody>
				{rows.map((cells, r) => (
					<tr>
						{cells.map((cell, c) => <td><RichText cms={cms} field={`rows.${r}.cells.${c}`} value={cell} /></td>)}
						{pad(cells.length).map(() => <td />)}
					</tr>
				))}
			</tbody>
		</table>
	)}
</Block>

<style>
	/* Scrolls sideways on a narrow screen instead of squeezing the columns. */
	.sl-kit-table {
		overflow-x: auto;
	}
	.sl-kit-table table {
		display: table;
		min-width: 100%;
	}
	.sl-kit-table :is(th, td) :global(p) {
		margin: 0;
	}
	.sl-kit-empty {
		color: var(--sl-color-gray-3);
		font-style: italic;
	}
</style>
