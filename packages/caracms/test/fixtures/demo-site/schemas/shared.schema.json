      "title": "Call to action",
      "type": "object",
      "properties": {
        "type": {
          "const": "cta"
        },
        "heading": {
          "title": "Heading",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "phone": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "lines"
              ],
              "additionalProperties": false
            }
          ]
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "button": {
          "title": "Button label",
          "type": "string"
        },
        "background": {
          "title": "Background",
          "enum": [
            "light",
            "dark",
            "photo"
          ]
        }
