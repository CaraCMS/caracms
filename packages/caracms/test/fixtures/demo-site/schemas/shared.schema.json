          "type": "string"
        },
        "show": {
          "title": "Which case studies",
          "enum": [
            "featured",
            "in-order"
          ]
        },
        "count": {
          "title": "How many",
          "type": [
            "number",
            "null"
          ]
        },
        "background": {
          "title": "Background",
          "enum": [
            "light",
            "dark",
            "photo"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
