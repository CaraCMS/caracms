              "title": "Heading",
              "type": "string"
            },
            "text": {
              "title": "Text",
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "p": {
                            "type": "string"
                          }
