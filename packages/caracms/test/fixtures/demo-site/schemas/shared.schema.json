            {
              "type": "null"
            }
          ]
        },
        "side": {
          "title": "Media side",
          "enum": [
            "left",
            "right"
          ]
        },
        "background": {
          "title": "Background",
          "enum": [
            "light",
            "dark",
            "photo"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
