                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "video": {
                  "type": "string",
                  "minLength": 1
                },
                "play": {
                  "enum": [
                    "loop",
                    "player"
                  ]
                },
                "poster": {
                  "type": "number",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "video"
              ],
              "additionalProperties": false
