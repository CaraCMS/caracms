---
/**
 * The gallery (M5b Decision 10): a heading and images at 4:5, two across, three from
 * 768px. Each image is its own slot (`images.<i>`), so a click in a preview opens its row;
 * the grid is the list's (`images`), ringed when the field is picked.
 *
 * `sizes`, from this CSS: two columns with a 0.75rem (12px) gap below 768, inside the
 * band's gutter (1.5rem below 640, 4rem from 640); three with a 1.5rem (24px) gap from
 * 768, until the band's 1312px cap at 1440px wide: (1312 − 48) / 3 ≈ 422px.
 */
import Block from 'caracms/components/Block.astro';
import Media from 'caracms/components/Media.astro';
import Text from 'caracms/components/Text.astro';
import type { BlockProps } from 'caracms/document';
import type { GalleryData } from './gallery.ts';

type Props = BlockProps<GalleryData>;
const { block, cms } = Astro.props;
const SIZES = '(min-width: 1440px) 422px, (min-width: 768px) calc((100vw - 176px) / 3), (min-width: 640px) calc((100vw - 140px) / 2), calc((100vw - 60px) / 2)';
const images = block.images.map((image, i) => ({ image, i })).filter((x) => x.image);
// In a preview, the grid is the list's own field, so picking Images rings it (the mockup's #gallery); each image is its row.
const listMarkers = cms.preview ? { 'data-cms-field': 'images', 'data-cms-kind': 'list' } : {};
---

<Block cms={cms} class={`band bg-${block.background} gallery`}>
	<div class="band-inner">
		<Text cms={cms} field="heading" value={block.heading} class="gallery-heading" />
		<div class="gallery-grid" {...listMarkers}>
			{images.map(({ image, i }) => <Media cms={cms} field={`images.${i}`} value={image} sizes={SIZES} ratio={4 / 5} class="gallery-image" />)}
		</div>
	</div>
</Block>

<style>
	.gallery {
		padding-block: 3.5rem;
	}

	.gallery-heading {
		margin: 0 0 1.5rem;
		font-size: 1.75rem;
		line-height: 1.2;
		font-weight: 650;
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}

	.gallery-grid :global(.gallery-image) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 0.25rem;
	}

	@media (width >= 640px) {
		.gallery {
			padding-block: 5rem;
		}

		.gallery-heading {
			font-size: 2.25rem;
		}
	}

	@media (width >= 768px) {
		.gallery-grid {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.5rem;
		}
	}
</style>
