      "properties": {
        "type": {
          "const": "hero"
        },
        "heading": {
          "title": "Heading",
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "phone": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "lines"
              ],
              "additionalProperties": false
            }
          ]
        },
        "intro": {
          "title": "Intro",
          "type": "string"
        },
        "buttons": {
          "title": "Buttons",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string"
              },
              "style": {
                "enum": [
                  "primary",
                  "secondary"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "media": {
          "title": "Image or video",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "alt": {
                  "type": "string"
                },
                "decorative": {
                  "type": "boolean"
                },
                "focal": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "video": {
                  "type": "string",
                  "minLength": 1
                },
                "play": {
                  "enum": [
                    "loop",
                    "player"
                  ]
                },
                "poster": {
                  "type": "number",
                  "minimum": 0
                },
                "name": {
                  "type": "string"
                },
                "duration": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "video"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "layout": {
          "title": "Layout",
          "enum": [
            "left",
            "centre"
          ]
        },
        "background": {
          "title": "Background",
          "description": "A hero with an image or video behind its text shows that instead of this.",
          "enum": [
            "light",
            "grey",
            "dark",
            "accent"
          ]
        },
        "spaceAbove": {
          "title": "Space above",
          "enum": [
            "none",
            "tight",
            "default",
            "extra"
          ]
        },
        "spaceBelow": {
          "title": "Space below",
          "enum": [
            "none",
            "tight",
            "default",
            "extra"
          ]
        }
