{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared blocks",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "default": {
      "description": "This shared block is its slot's default: pages that don't pick one get it.",
      "const": true
    },
    "block": {
      "anyOf": [
        {
          "$ref": "#/$defs/block:hero"
        },
        {
          "$ref": "#/$defs/block:text"
        },
        {
          "$ref": "#/$defs/block:tm"
        },
        {
          "$ref": "#/$defs/block:columns"
        },
        {
          "$ref": "#/$defs/block:cards"
        },
        {
          "$ref": "#/$defs/block:features"
        },
        {
          "$ref": "#/$defs/block:faq"
        },
        {
          "$ref": "#/$defs/block:media"
        },
        {
          "$ref": "#/$defs/block:gallery"
        },
        {
          "$ref": "#/$defs/block:cta"
        },
        {
          "$ref": "#/$defs/block:cases"
        },
        {
          "$ref": "#/$defs/block:posts"
        },
        {
          "$ref": "#/$defs/block:form"
        },
        {
          "$ref": "#/$defs/block:siteHeader"
        },
        {
          "$ref": "#/$defs/block:siteFooter"
        }
      ]
    }
  },
  "required": [
    "title",
    "block"
  ],
  "additionalProperties": false,
  "$defs": {
    "block:hero": {
