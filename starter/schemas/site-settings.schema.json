    "pageOrder": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "The Pages tree's order in the editor: a parent's path (\"\" for the top level) → its children's slugs. Written by Arrange pages."
    },
    "pageFolders": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "name",
            "pages"
          ],
          "additionalProperties": false
        }
      },
      "description": "The Pages tree's folders in the editor (they never change an address): a level's path (\"\" for the top level) → its folders, each { id, name, pages }. A folder's place is \"(<id>)\" in that level's pageOrder list. Written by Arrange pages."
    },
    "collectionOrder": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "The hand order of each collection with order: 'manual': its name → its documents' paths, first to last. Written by dragging in the editor's list."
    },
