---
/**
 * Cards (M7 Decision 10): a heading group, then a grid of cards, each an optional
 * image or loop at 3:2, a heading at h4 size, some text in the soft colour and one
 * link. A card with no media starts with its heading, with no empty frame; a card
 * with nothing in it isn't drawn (Acceptance 27). Each card is its own row of the
 * `items` list, so a click in a preview opens it. Schema beside it in cards.ts.
 */
import Block from 'caracms/components/Block.astro';
import Buttons from 'caracms/components/Buttons.astro';
import Media from 'caracms/components/Media.astro';
import Text from 'caracms/components/Text.astro';
import type { BlockProps } from 'caracms/document';
import { bandClass } from './background.ts';
import type { CardsData } from './cards.ts';
import { gridSizes, perRowClass } from './grid.ts';

type Props = BlockProps<CardsData>;
const { block, cms } = Astro.props;
const sizes = gridSizes(Number(block.perRow));
const items = block.items.map((item, i) => ({ item, i })).filter(({ item }) => cms.preview || item.media || item.heading || item.text || item.button.length > 0);
// In a preview, the grid is the list's own field, so picking Cards rings it; each card is its row.
const listMarkers = cms.preview ? { 'data-cms-field': 'items', 'data-cms-kind': 'list' } : {};
---

<Block cms={cms} class={bandClass(block)}>
	<div class="content-container">
		{
			(block.heading || block.intro || cms.preview) && (
				<div class="head">
					<Text cms={cms} field="heading" value={block.heading} class="text-h2" />
					<Text cms={cms} field="intro" value={block.intro} class="text-lead" />
				</div>
			)
		}
		<ul class={perRowClass(block.perRow)} role="list" {...listMarkers}>
			{
				items.map(({ item, i }) => (
					<li class="grid content-start gap-3">
						{item.media && <Media cms={cms} field={`items.${i}.media`} value={item.media} sizes={sizes} ratio={3 / 2} class="frame frame-landscape mb-2" />}
						<Text cms={cms} field={`items.${i}.heading`} value={item.heading} as="h3" class="text-h4" />
						<Text cms={cms} field={`items.${i}.text`} value={item.text} class="fg-soft" />
						<Buttons cms={cms} field={`items.${i}.button`} value={item.button} class="btn-row" buttonClass="btn" />
					</li>
				))
			}
		</ul>
	</div>
</Block>
