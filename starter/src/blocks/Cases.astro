---
/**
 * The case-study list (M5a Decision 17): Featured or In order, both in Site order (the case
 * studies' hand order, review gaps Decision 5a: `documents()` returns them in it),
 * up to its count (3 when the count is empty or out of range: the render gets null).
 * Schema beside it in cases.ts. The case studies come from the render context
 * (Decision 9), the same source as the page itself.
 *
 * M5b: each card is one link: its case study's cover at 3:2, its sector, its title
 * at h4 size and its summary. Three per row on desktop, two on tablets, one on phones
 * (`sizes` from grid.ts).
 *
 * Edit in context (Decisions 10, 16): each card is marked as its case study (`cms.of(entry)`),
 * and its cover as that case study's field, so a click on a card in the selected block opens
 * the case study over the page.
 */
import Block from 'caracms/components/Block.astro';
import Media from 'caracms/components/Media.astro';
import Text from 'caracms/components/Text.astro';
import type { BlockProps } from 'caracms/document';
import { sectorLabel, type CaseStudyData } from '../collections/case-studies.ts';
import { bandClass } from './background.ts';
import { DEFAULT_COUNT, type CasesData } from './cases.ts';
import { gridSizes, perRowClass } from './grid.ts';

type Props = BlockProps<CasesData>;
const { block, cms } = Astro.props;
const COVER_SIZES = gridSizes(3);
const all = await cms.read.documents('case-studies');
const shown = all
	.map((r) => ({ entry: r, url: r.url, title: r.title, data: r.data as CaseStudyData }))
	.filter((r) => block.show !== 'featured' || r.data.featured)
	.slice(0, block.count ?? DEFAULT_COUNT);
---

<Block cms={cms} class={bandClass(block)}>
	<div class="content-container">
		{
			(block.heading || cms.preview) && (
				<div class="head">
					<Text cms={cms} field="heading" value={block.heading} class="text-h2" />
				</div>
			)
		}
		<ul class={perRowClass('3')} role="list">
			{
				shown.map((c) => (
					<Block cms={cms.of(c.entry)} as="li">
						<a class="case-card grid content-start gap-2 no-underline" href={c.url ?? undefined}>
							{c.data.cover && <Media cms={cms.of(c.entry)} field="cover" value={c.data.cover} sizes={COVER_SIZES} ratio={3 / 2} class="frame frame-landscape mb-3" />}
							<Block cms={cms.of(c.entry)} field="sector" as="span" class="eyebrow fg-muted">
								{sectorLabel(c.data.sector)}
							</Block>
							<b class="case-title text-h4">{c.title}</b>
							{c.data.summary && <Text cms={cms.of(c.entry)} field="summary" value={c.data.summary} as="span" class="fg-muted" />}
						</a>
					</Block>
				))
			}
		</ul>
	</div>
</Block>

<style>
	.case-card:hover .case-title {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.case-card:focus-visible {
		outline-offset: 6px;
		border-radius: var(--radius-media);
	}
</style>
