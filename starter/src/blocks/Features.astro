---
/**
 * Features (M7 Decision 10): a heading group, then short points, each a heading at h4
 * size and its text in the soft colour, under a 1px rule in the band's text colour.
 * 2 or 3 per row on desktop, 2 on tablets, 1 on phones. No icons. Schema beside it in
 * features.ts.
 */
import Block from 'caracms/components/Block.astro';
import Text from 'caracms/components/Text.astro';
import type { BlockProps } from 'caracms/document';
import { bandClass } from './background.ts';
import type { FeaturesData } from './features.ts';
import { perRowClass } from './grid.ts';

type Props = BlockProps<FeaturesData>;
const { block, cms } = Astro.props;
const items = block.items.map((item, i) => ({ item, i })).filter(({ item }) => cms.preview || item.heading || item.text);
const listMarkers = cms.preview ? { 'data-cms-field': 'items', 'data-cms-kind': 'list' } : {};
---

<Block cms={cms} class={bandClass(block)}>
	<div class="content-container">
		{
			(block.heading || block.intro || cms.preview) && (
				<div class="head">
					<Text cms={cms} field="heading" value={block.heading} class="text-h2" />
					<Text cms={cms} field="intro" value={block.intro} class="text-lead" />
				</div>
			)
		}
		<ul class={`${perRowClass(block.perRow)} gap-y-10`} role="list" {...listMarkers}>
			{
				items.map(({ item, i }) => (
					<li class="feature grid content-start gap-3 pt-5">
						<Text cms={cms} field={`items.${i}.heading`} value={item.heading} as="h3" class="text-h4" />
						<Text cms={cms} field={`items.${i}.text`} value={item.text} class="fg-soft" />
					</li>
				))
			}
		</ul>
	</div>
</Block>

<style>
	.feature {
		border-top: 1px solid var(--fg);
	}
</style>
