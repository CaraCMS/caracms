---
/**
 * The Form block (M6 Decision 17): a heading and an intro in the first third on
 * desktop, and one of the site's forms in the last two, through the package's Form
 * component, which posts without JavaScript. Schema beside it in form.ts. M7: its look
 * is the tokens (labels above, first and last name sharing a row from 768). Form rows: a rows
 * field's rows are thin-bordered boxes with the fields' rhythm inside, Add another and Remove
 * secondary buttons.
 *
 * Review gaps (Decision 14): it declares the form's states (form.ts) and passes `cms.state` on,
 * so the editor's switch shows Sent, Couldn't send and Invalid. Its words are all Site Settings ›
 * Forms' (the sent heading is seeded there, so a send shows the sent panel), so the sidebar's grey
 * words are the ones the page falls back to.
 */
import Block from 'caracms/components/Block.astro';
import Form from 'caracms/components/Form.astro';
import Text from 'caracms/components/Text.astro';
import type { BlockProps } from 'caracms/document';
import { bandClass } from './background.ts';
import type { FormBlockData } from './form.ts';

type Props = BlockProps<FormBlockData>;
const { block, cms } = Astro.props;
---

<Block cms={cms} class={`${bandClass(block)} form-block`}>
	<div class="content-container split">
		<div class="head">
			<Text cms={cms} field="heading" value={block.heading} class="text-h2" />
			{(block.intro || cms.preview) && <Text cms={cms} field="intro" value={block.intro} class="text-lead" />}
		</div>
		<div>
			<Form form={block.form} preview={cms.preview} state={cms.state} />
		</div>
	</div>
</Block>

<style>
	.form-block :global(.cms-form) {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: calc(var(--spacing) * 5);
	}

	.form-block :global(.cms-form-field) {
		display: grid;
		gap: calc(var(--spacing) * 2);
		min-width: 0;
	}

	.form-block :global(.cms-form-label) {
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
		font-weight: var(--font-weight-medium);
	}

	.form-block :global(.cms-form-optional) {
		font-weight: var(--font-weight-normal);
		color: var(--fg-muted);
	}

	.form-block :global(.cms-form input:not([type='file'])),
	.form-block :global(.cms-form select),
	.form-block :global(.cms-form textarea) {
		width: 100%;
		min-height: calc(var(--spacing) * 12);
		padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
		border: 1px solid var(--color-grey-500);
		border-radius: var(--radius-control);
		background: var(--color-surface);
		color: var(--color-ink);
		font: inherit;
		transition:
			border-color 150ms ease,
			box-shadow 150ms ease;
	}

	.form-block :global(.cms-form textarea) {
		min-height: calc(var(--spacing) * 36);
		resize: vertical;
	}

	.form-block :global(.cms-form input:not([type='file']):hover),
	.form-block :global(.cms-form select:hover),
	.form-block :global(.cms-form textarea:hover) {
		border-color: var(--color-ink);
	}

	.form-block :global(.cms-form input:not([type='file']):focus),
	.form-block :global(.cms-form select:focus),
	.form-block :global(.cms-form textarea:focus) {
		outline: none;
		border-color: var(--color-accent);
		box-shadow: 0 0 0 1px var(--color-accent);
	}

	.form-block :global(.cms-form input[type='file']) {
		width: 100%;
		padding: calc(var(--spacing) * 5) calc(var(--spacing) * 4);
		border: 1px dashed var(--color-grey-500);
		border-radius: var(--radius-control);
		font: inherit;
	}

	/* M6: the files chosen so far (the form's script adds picks up), each with its size and Remove */
	.form-block :global(.cms-form-files) {
		display: grid;
		gap: calc(var(--spacing) * 1.5);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.form-block :global(.cms-form-files[hidden]) {
		display: none;
	}

	.form-block :global(.cms-form-file) {
		display: flex;
		align-items: baseline;
		gap: calc(var(--spacing) * 2.5);
		min-width: 0;
		padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
		border: 1px solid var(--line);
		border-radius: var(--radius-control);
		font-size: var(--text-small);
	}

	.form-block :global(.cms-form-file-name) {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.form-block :global(.cms-form-file-size) {
		flex: none;
		color: var(--fg-muted);
	}

	.form-block :global(.cms-form-file-remove) {
		flex: none;
		padding: 0;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-weight: var(--font-weight-medium);
		text-decoration: underline;
		cursor: pointer;
	}

	.form-block :global(.cms-form-help) {
		margin: 0;
		font-size: var(--text-small);
		color: var(--fg-muted);
	}

	.form-block :global(.cms-form-error),
	.form-block :global(.cms-form-status.cms-form-failed) {
		margin: 0;
		font-size: var(--text-small);
		color: var(--color-error);
	}

	/* Form rows (Decision 12): a rows field is a fieldset, its legend the field's label; each row a
	   thin-bordered box holding its row word and its cells, stacked with the fields' own rhythm. */
	.form-block :global(.cms-form-rows) {
		min-inline-size: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.form-block :global(.cms-form-rows > legend) {
		padding: 0;
		margin-bottom: calc(var(--spacing) * 2);
	}

	.form-block :global(.cms-form-rows-body),
	.form-block :global(.cms-form-row-list) {
		display: grid;
		gap: calc(var(--spacing) * 3);
		min-width: 0;
	}

	.form-block :global(.cms-form-row) {
		display: grid;
		gap: calc(var(--spacing) * 5);
		min-width: 0;
		padding: calc(var(--spacing) * 4);
		border: 1px solid var(--line);
		border-radius: var(--radius-control);
	}

	/* "Booking 1": a small label in the legend's family, quieter than it. */
	.form-block :global(.cms-form-row-label) {
		margin: 0 0 calc(var(--spacing) * -2);
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
		font-weight: var(--font-weight-medium);
		color: var(--fg-muted);
	}

	.form-block :global(.cms-form-cell) {
		display: grid;
		gap: calc(var(--spacing) * 2);
		min-width: 0;
	}

	/* Add another and Remove are secondary buttons (site.css's roles): outlined, smaller than the Send button. */
	.form-block :global(.cms-form-add),
	.form-block :global(.cms-form-row-remove) {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		min-height: calc(var(--spacing) * 10);
		padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
		border: 1px solid var(--btn-2-line);
		border-radius: var(--radius-control);
		background: transparent;
		color: var(--btn-2-fg);
		font: inherit;
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
		font-weight: var(--font-weight-medium);
		cursor: pointer;
		transition:
			background-color 150ms ease,
			color 150ms ease,
			border-color 150ms ease;
	}

	/* Hidden until the script runs, and in Add's place once the rows are full: never drawn then. */
	.form-block :global(.cms-form-add[hidden]) {
		display: none;
	}

	/* Remove sits inside its row, quieter still: a hairline border until hovered. */
	.form-block :global(.cms-form-row-remove) {
		min-height: calc(var(--spacing) * 9);
		padding: calc(var(--spacing) * 1.5) calc(var(--spacing) * 3);
		border-color: var(--line);
	}

	.form-block :global(button.cms-form-add:hover),
	.form-block :global(button.cms-form-row-remove:hover) {
		background: var(--btn-2-hover-bg);
		border-color: var(--btn-2-hover-bg);
		color: var(--btn-2-hover-fg);
	}

	.form-block :global(.cms-form-at-most) {
		margin: 0;
		font-size: var(--text-small);
		color: var(--fg-muted);
	}

	@media (min-width: 48rem) {
		.form-block :global(.cms-form-row) {
			padding: calc(var(--spacing) * 5);
		}
	}

	/* The submit is a primary button (site.css's roles). */
	.form-block :global(.cms-form-submit) {
		justify-self: start;
		min-height: calc(var(--spacing) * 12);
		padding: calc(var(--spacing) * 3) calc(var(--spacing) * 5);
		border: 1px solid var(--btn-1-bg);
		border-radius: var(--radius-control);
		background: var(--btn-1-bg);
		color: var(--btn-1-fg);
		font: inherit;
		font-weight: var(--font-weight-medium);
		cursor: pointer;
	}

	.form-block :global(.cms-form-submit:hover) {
		background: var(--btn-1-hover);
		border-color: var(--btn-1-hover);
	}

	.form-block :global(.cms-form-submit[disabled]) {
		opacity: 0.5;
	}

	.form-block :global(.cms-form-status) {
		margin: 0;
		min-height: 1.5em;
	}

	/* A field in error: after a real failed submit (:user-invalid) and in the editor's Invalid state (aria-invalid), the same red edge. */
	.form-block :global(.cms-form input:not([type='file']):user-invalid),
	.form-block :global(.cms-form select:user-invalid),
	.form-block :global(.cms-form textarea:user-invalid),
	.form-block :global(.cms-form input[type='file']:user-invalid),
	.form-block :global(.cms-form .cms-form-field :is(input, select, textarea)[aria-invalid='true']) {
		border-color: var(--color-error);
	}

	/* Review gaps: once it's sent, the form gives way to its heading and line, on a grey card.
	   Only drawn when a sent heading resolves, so a site with none looks as 0.10.0 did. */
	.form-block :global(.cms-form-sent) {
		grid-column: 1 / -1;
		display: grid;
		align-content: start;
		gap: calc(var(--spacing) * 2);
		padding: calc(var(--spacing) * 8);
		border-radius: var(--radius-control);
		background: var(--color-grey-50);
	}

	.form-block :global(.cms-form-sent-heading) {
		justify-self: start;
		margin: 0;
		font-size: var(--text-h3);
		line-height: var(--text-h3--line-height);
		letter-spacing: var(--text-h3--letter-spacing);
		font-weight: var(--font-weight-semibold);
	}

	.form-block :global(.cms-form-sent-line) {
		justify-self: start;
		margin: 0;
		font-size: var(--text-lead);
		line-height: var(--text-lead--line-height);
		color: var(--color-grey-700);
	}

	@media (min-width: 48rem) {
		.form-block :global(.cms-form) {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			column-gap: calc(var(--spacing) * 5);
		}

		.form-block :global(.cms-form-field:not([data-type='text'], [data-type='email'], [data-type='tel'])),
		.form-block :global(.cms-form-turnstile),
		.form-block :global(.cms-form-status),
		.form-block :global(.cms-form-submit) {
			grid-column: 1 / -1;
		}
	}
</style>
