---
/**
 * The Posts block (posts and tags, Decisions 9–10; schema beside it in posts.ts). Latest: the
 * newest `count` posts (3 when it's empty or out of range). All: page `cms.listPage` of the
 * posts, ten a page, with a pager under the cards when there's more than one page (only the page's
 * first unshared All block pages; a shared or later one shows its first ten, Decision 10): "Newer
 * posts", "Page n of N", "Older posts", plain links, no numbers to jump to. With a Tag, only
 * that tag's posts, and the pages follow them. A Tag that's been deleted reads as null: no filter.
 *
 * The cards are the case card's (components/PostCard.astro), three per row on desktop. The
 * posts come from the render context, the same source as the page: the editor's drafts in a
 * preview, which is always page 1 (the pager's links don't navigate the editor away).
 */
import Block from 'caracms/components/Block.astro';
import Text from 'caracms/components/Text.astro';
import { documentUrl } from 'caracms/content';
import type { BlockProps } from 'caracms/document';
import { site } from 'virtual:caracms/config';
import { journalPosts } from '../collections/journal.ts';
import PostCard from '../components/PostCard.astro';
import { bandClass } from './background.ts';
import { gridSizes, perRowClass } from './grid.ts';
import { DEFAULT_COUNT, PAGE_SIZE, pageAddress, pageCount, pagesHere, type PostsData } from './posts.ts';

type Props = BlockProps<PostsData>;
const { block, cms } = Astro.props;
const all = await journalPosts(cms.read, block.tag);
// Only the page's paging block (posts.ts → pagesHere) follows `listPage` and draws the pager; a
// shared All block, or a later one, shows its first ten on every page.
const paged = block.show === 'all' && (await pagesHere(cms, Astro.url));
const pages = paged ? pageCount(all.length) : 1;
const page = Math.min(cms.listPage, pages);
const shown = paged ? all.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE) : all.slice(0, block.show === 'all' ? PAGE_SIZE : (block.count ?? DEFAULT_COUNT));

// The listing's own address: a public page's path without its `/page/<n>`; a preview's, its document's.
const previewOf = (collection: string | null, path: string | null) => (collection && path !== null && Object.hasOwn(site.collections, collection) ? documentUrl(site.collections[collection]!, path) : null);
const own = cms.preview ? previewOf(Astro.url.searchParams.get('collection'), Astro.url.searchParams.get('path')) : Astro.url.pathname.replace(/\/page\/\d+\/?$/, '');
const base = own ? own.replace(/(.)\/+$/, '$1') || '/' : '/';
---

<Block cms={cms} class={bandClass(block)}>
	<div class="content-container">
		{
			(block.heading || cms.preview) && (
				<div class="head">
					<Text cms={cms} field="heading" value={block.heading} class="text-h2" />
				</div>
			)
		}
		{
			shown.length > 0 ? (
				<ul class={perRowClass('3')} role="list">
					{shown.map((post) => (
						<li>
							<PostCard post={post} cms={cms} sizes={gridSizes(3)} />
						</li>
					))}
				</ul>
			) : (
				<p class="fg-muted" data-cms-fixed>No posts yet.</p>
			)
		}
		{
			pages > 1 && (
				<nav class="pager mt-12 flex items-center justify-between gap-4" aria-label="Pages">
					<span class="pager-side" data-cms-fixed>{page > 1 && <a class="link whitespace-nowrap" rel="prev" href={pageAddress(base, page - 1)}>Newer posts</a>}</span>
					<span class="fg-muted whitespace-nowrap text-small" data-cms-fixed>Page {page} of {pages}</span>
					<span class="pager-side text-right" data-cms-fixed>{page < pages && <a class="link whitespace-nowrap" rel="next" href={pageAddress(base, page + 1)}>Older posts</a>}</span>
				</nav>
			)
		}
	</div>
</Block>

<style>
	.pager-side {
		flex: 1 1 0;
	}
</style>
